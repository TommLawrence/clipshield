# ClipShield — Firebase web app configuration (public values only)
# Copy to .env.local and fill in the values from YOUR Firebase project:
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration

# --- Required: Firebase web app config ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Required in production: App Check reCAPTCHA v3 site key ---
# Firebase Console → App Check → Apps → your web app → reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# NOTE: never put private keys, service-account files, or debug tokens in
# this repository. Firebase web SDK config values are public identifiers;
# security is enforced by App Check + Firestore rules.
